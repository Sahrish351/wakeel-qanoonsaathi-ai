# ============================================================
# WAKEEL — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- FRONTEND-SAFE (Supabase public credentials) ---
# These use the VITE_ prefix so Vite can inject them into the browser bundle.
# Both values are safe to include in client code — they are designed to be public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ============================================================
# The following variables are NEVER used in frontend code.
# They are ONLY used in Supabase Edge Functions via Supabase secrets.
# DO NOT add them here for any frontend purpose.
# ============================================================

# GEMINI_API_KEY=         <-- Set in Supabase Edge Function secrets ONLY
# SUPABASE_SERVICE_ROLE_KEY=  <-- Set in Supabase Edge Function secrets ONLY

# ============================================================
# App configuration (frontend-safe)
# ============================================================
VITE_APP_NAME=Wakeel
VITE_APP_URL=http://localhost:5173

